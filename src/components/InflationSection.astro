---
// Problém (PAS): peníze na účtu ztrácí hodnotu. Reálná data ČSÚ, animované „smrštění“ a sloupce inflace.
import { inflation } from '../lib/market';
import { czk, dec, pct } from '../lib/format';
const maxRate = Math.max(...inflation.years.map(([, r]) => r));
const lostPct = 1 - inflation.realValueOf100k / 100000;
---
<div class="grid grid-cols-1 gap-5 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)]">
  <div class="card p-6 sm:p-8" data-reveal>
    <p class="text-[14px] text-[var(--color-muted)]">100 000 Kč, které jste si v roce {inflation.from} dali stranou, mají dnes skutečnou hodnotu</p>
    <p class="num mt-2 text-[clamp(2.4rem,5vw,3.4rem)] leading-none font-semibold tracking-[-0.045em]">{czk(Math.round(inflation.realValueOf100k / 100) * 100)}</p>
    <div class="mt-6 space-y-3">
      <div>
        <div class="flex justify-between text-[12.5px] text-[var(--color-muted)]"><span>{inflation.from}</span><span class="num">100 000 Kč</span></div>
        <div class="mt-1 h-3 rounded-full bg-[var(--color-ink)]"></div>
      </div>
      <div>
        <div class="flex justify-between text-[12.5px] text-[var(--color-muted)]"><span>{inflation.to}</span><span class="num text-[var(--color-neg)]">−{pct(lostPct, 0)} kupní síly</span></div>
        <div class="relative mt-1 h-3 rounded-full bg-[var(--color-neg-soft)]">
          <div class="shrink absolute inset-y-0 left-0 rounded-full bg-[var(--color-ink)]" style={`--w:${(inflation.realValueOf100k / 1000).toFixed(1)}%`}></div>
        </div>
      </div>
    </div>
    <p class="mt-5 text-[13px] text-[var(--color-faint)]">Ceny za {inflation.years.length} let vzrostly o {pct(inflation.cumulative, 0)}. Zdroj: <a class="underline" href={inflation.sourceUrl} target="_blank" rel="noopener">{inflation.source}</a>, průměrná roční inflace.</p>
  </div>

  <div class="card p-6 sm:p-8" data-reveal style="--i:1">
    <p class="text-[14px] text-[var(--color-muted)]">Inflace v Česku po letech</p>
    <div class="cols mt-6 flex h-[180px] items-end gap-1.5 sm:gap-2.5" role="img" aria-label="Roční inflace v ČR">
      {inflation.years.map(([y, r], i) => (
        <div class="flex h-full flex-1 flex-col items-center justify-end gap-1.5">
          <span class:list={['num text-[11px]', r === maxRate ? 'font-semibold text-[var(--color-neg)]' : 'text-[var(--color-muted)]']}>{dec(r * 100, r >= 0.1 ? 0 : 1)}</span>
          <div class:list={['col w-full rounded-t-md', r === maxRate ? 'bg-[var(--color-neg)]' : r > 0.05 ? 'bg-[#f2a3a2]' : 'bg-[var(--color-soft-2)]']} style={`--h:${(r / maxRate) * 100}%;--i:${i}`}></div>
          <span class="num text-[10.5px] text-[var(--color-faint)]">'{y.slice(2)}</span>
        </div>
      ))}
    </div>
    <p class="mt-4 text-[13px] text-[var(--color-faint)]">Průměrná roční inflace v %, zdroj ČSÚ. Nejvíc peníze ztrácely v letech 2022 a 2023.</p>
  </div>
</div>

<style>
  .shrink { width: 100%; transition: width 1.6s var(--ease-out-expo) 0.3s; }
  :global([data-reveal].in) .shrink, :global(html:not(.js)) .shrink { width: var(--w); }
  .col { height: 4%; transition: height 1.1s var(--ease-out-expo); transition-delay: calc(var(--i) * 60ms + 200ms); }
  :global([data-reveal].in) .col, :global(html:not(.js)) .col { height: var(--h); }
</style>
