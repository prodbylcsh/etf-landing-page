---
import TwinCards from './TwinCards.astro';
import Brand from './Brand.astro';
---
<div data-ad="ad-a-feed" class="ad paper-grain h-[1350px] w-[1080px] bg-[var(--color-paper)] p-[72px] text-[var(--color-ink)]">
  <div class="flex items-center justify-between"><Brand /><span class="font-mono text-[24px] tracking-[0.12em] text-[var(--color-muted)]">ETF Z NYSE → ČESKO</span></div>
  <h1 class="mt-[90px] font-[family-name:var(--font-display)] text-[112px] leading-[0.98] font-semibold tracking-[-0.02em]">Chcete VOO?<br />Kupte jeho <em class="underline-ink font-medium">dvojče.</em></h1>
  <div class="mt-[90px]"><TwinCards /></div>
  <div class="absolute right-[72px] bottom-[72px] left-[72px] flex items-center justify-between border-t-[4px] border-double border-[var(--color-ink)] pt-[36px]">
    <p class="text-[34px] leading-tight">12 slavných ETF a jejich<br /><b>evropská dvojčata</b></p>
    <span class="rounded-[18px] bg-[var(--color-stamp)] px-[40px] py-[26px] text-[36px] font-bold text-white">Tahák zdarma →</span>
  </div>
</div>
