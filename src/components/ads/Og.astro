---
import Brand from './Brand.astro';
import GrowthArt from './GrowthArt.astro';
import { millions, monthlyLabel } from './headline';
---
<div data-ad="og" class="ad relative flex h-[630px] w-[1200px] items-center gap-[60px] overflow-hidden bg-white px-[70px] text-[#0a0a0a]">
  <div class="ad-grid absolute inset-0"></div>
  <div class="relative w-[560px] shrink-0">
    <Brand size={40} />
    <h1 class="mt-[36px] text-[76px] leading-[0.98] font-semibold tracking-[-0.05em]">Z {monthlyLabel} měsíčně může být <span class="hl">{millions}.</span></h1>
    <p class="mt-[24px] text-[24px] text-[#71717a]">Spočítejte si to a začněte s ETF krok za krokem.</p>
  </div>
  <div class="relative"><GrowthArt width={460} height={200} /></div>
</div>
