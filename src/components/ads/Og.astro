---
import Brand from './Brand.astro';
import TwinCards from './TwinCards.astro';
---
<div data-ad="og" class="ad relative flex h-[630px] w-[1200px] items-center gap-[50px] overflow-hidden bg-white px-[70px] text-[#0a0a0a]">
  <div class="ad-grid absolute inset-0"></div>
  <div class="relative flex-1">
    <Brand size={40} />
    <h1 class="mt-[40px] text-[78px] leading-[0.98] font-semibold tracking-[-0.05em]">Chcete VOO? Kupte si jeho <span class="hl">dvojče.</span></h1>
    <p class="mt-[26px] text-[26px] text-[#71717a]">12 slavných ETF z NYSE a jejich evropská dvojčata</p>
  </div>
  <div class="relative"><TwinCards scale={0.52} /></div>
</div>
