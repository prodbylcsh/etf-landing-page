---
// Dvojice karet „VOO (nekoupíte) → dvojče“ pro kreativy. Rozměry v px pro plátno 1080 px.
import { etfByTicker } from '../../lib/market';
import { ter } from '../../lib/format';
const voo = etfByTicker.VOO;
---
<div class="flex items-stretch gap-[28px]">
  <div class="relative w-[430px] rounded-[28px] bg-[var(--color-paper-2)] p-[40px] ring-[3px] ring-[var(--color-rule)]">
    <p class="font-mono text-[24px] tracking-[0.12em] text-[var(--color-muted)]">NYSE · USA</p>
    <p class="mt-[14px] font-mono text-[120px] leading-none font-bold tracking-[-0.04em]">VOO</p>
    <p class="mt-[14px] text-[30px] leading-tight text-[var(--color-muted)]">{voo.nameCz}</p>
    <span class="absolute top-[-30px] right-[-34px] rotate-[8deg] shadow-[0_6px_0_rgba(0,0,0,0.04)] rounded-[12px] border-[6px] border-[var(--color-stamp)] bg-[var(--color-paper-2)] px-[18px] py-[8px] font-mono text-[34px] font-extrabold tracking-[0.06em] text-[var(--color-stamp)]">V ČR NEKOUPÍTE</span>
  </div>
  <div class="flex items-center font-mono text-[64px] text-[var(--color-muted)]">→</div>
  <div class="w-[430px] rounded-[28px] bg-[var(--color-term)] p-[40px] text-white">
    <p class="font-mono text-[24px] tracking-[0.12em] text-[var(--color-phosphor)]">DVOJČE · EU ✓</p>
    <p class="mt-[14px] font-mono text-[120px] leading-none font-bold tracking-[-0.04em]">{voo.twin.ticker}</p>
    <p class="mt-[14px] text-[30px] leading-tight text-[#b9c7c0]">stejný index<br />TER {ter(voo.twin.ter)}</p>
  </div>
</div>
