---
// „VOO (nekoupíte) → dvojče“ pro kreativy. Rozměry v px pro plátno 1080 px.
import { etfByTicker } from '../../lib/market';
import { ter } from '../../lib/format';
import { FlagEU, FlagUS } from '../icons';
interface Props { scale?: number }
const { scale = 1 } = Astro.props;
const voo = etfByTicker.VOO;
const s = (n: number) => `${n * scale}px`;
---
<div style={`width:${s(860)}`}>
  <div class="flex items-center bg-white" style={`gap:${s(32)};padding:${s(36)};border-radius:${s(40)};box-shadow:0 0 0 ${s(2)} #e8e8e6, 0 ${s(30)} ${s(60)} -${s(30)} rgba(0,0,0,.25)`}>
    <span class="flex items-center justify-center" style={`width:${s(110)};height:${s(110)};border-radius:${s(30)};background:#f6f6f5`}><FlagUS size={40 * scale} /></span>
    <span class="flex-1">
      <span class="block" style={`font-size:${s(26)};color:#71717a`}>NYSE · USA</span>
      <span class="mono block font-semibold" style={`font-size:${s(84)};line-height:1;letter-spacing:-0.04em`}>VOO</span>
    </span>
    <span class="font-semibold" style={`font-size:${s(30)};padding:${s(12)} ${s(24)};border-radius:999px;background:#fdecec;color:#e34948`}>✕ v ČR ne</span>
  </div>
  <div class="relative flex items-center justify-center" style={`height:${s(110)}`}>
    <span class="absolute" style={`top:0;bottom:0;left:50%;border-left:${s(4)} dashed #d4d4d8`}></span>
    <span class="relative bg-white font-medium" style={`font-size:${s(26)};padding:${s(10)} ${s(26)};border-radius:999px;box-shadow:0 0 0 ${s(2)} #e8e8e6`}>stejný index</span>
  </div>
  <div class="flex items-center" style={`gap:${s(32)};padding:${s(36)};border-radius:${s(40)};background:#0b0c0e;color:#fff;box-shadow:0 ${s(40)} ${s(80)} -${s(30)} rgba(0,0,0,.45)`}>
    <span class="flex items-center justify-center" style={`width:${s(110)};height:${s(110)};border-radius:${s(30)};background:#16181b`}><FlagEU size={40 * scale} /></span>
    <span class="flex-1">
      <span class="block" style={`font-size:${s(26)};color:#a1a1aa`}>Evropské dvojče · TER {ter(voo.twin.ter)}</span>
      <span class="mono block font-semibold" style={`font-size:${s(84)};line-height:1;letter-spacing:-0.04em`}>{voo.twin.ticker}</span>
    </span>
    <span class="font-semibold" style={`font-size:${s(30)};padding:${s(12)} ${s(24)};border-radius:999px;background:#c9f24b;color:#0a0a0a`}>✓ koupíte</span>
  </div>
</div>
