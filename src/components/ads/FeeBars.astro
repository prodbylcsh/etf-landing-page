---
// Pruhy „ETF vs. fond“ s ukousnutým koncem. Plátno 1080 px.
import { cheapTwinTer, czechFund } from '../../lib/market';
import { feeComparison } from '../../lib/finance';
import { czkShort, pct, ter } from '../../lib/format';
const r = feeComparison(3000, 25, 0.07, cheapTwinTer, czechFund.value);
const w = 920;
---
<div class="space-y-[34px]">
  <div>
    <div class="flex justify-between text-[32px] text-[#c9d4ce]"><span>ETF dvojče · {ter(cheapTwinTer)}</span><span class="font-mono text-white">{czkShort(r.cheap)}</span></div>
    <div class="mt-[12px] h-[46px] rounded-full bg-[var(--color-phosphor)]" style={`width:${w}px`} />
  </div>
  <div>
    <div class="flex justify-between text-[32px] text-[#c9d4ce]"><span>Typický český fond · {pct(czechFund.value, 2)}</span><span class="font-mono text-white">{czkShort(r.expensive)}</span></div>
    <div class="relative mt-[12px] h-[46px]" style={`width:${w}px`}>
      <div class="absolute inset-y-0 left-0 rounded-full bg-[#c68a00]" style={`width:${(r.expensive / r.cheap) * w}px;-webkit-mask:radial-gradient(circle 34px at 100% 30%, transparent 98%, #000 100%);mask:radial-gradient(circle 34px at 100% 30%, transparent 98%, #000 100%)`} />
      <div class="absolute inset-y-0 rounded-r-full border-[3px] border-dashed border-[#5d6d66]" style={`left:${(r.expensive / r.cheap) * w + 8}px;right:0`} />
    </div>
  </div>
</div>
