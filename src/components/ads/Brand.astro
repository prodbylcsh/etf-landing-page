---
interface Props { dark?: boolean; size?: number }
const { dark = false, size = 46 } = Astro.props;
const fg = dark ? '#ffffff' : '#0a0a0a';
const hole = dark ? '#0b0c0e' : '#ffffff';
---
<span class="inline-flex items-center" style={`gap:${size * 0.3}px;color:${fg}`}>
  <svg viewBox="0 0 32 32" width={size} height={size}>
    <path fill={fg} d="M16 2a14 14 0 1 0 13.6 17.3 4.6 4.6 0 0 1-5.4-5.6 4.6 4.6 0 0 1-5.3-6.6A4.6 4.6 0 0 1 16.6 2Z" />
    <circle cx="11" cy="12" r="1.9" fill={hole} /><circle cx="10" cy="20.5" r="1.6" fill={hole} /><circle cx="18" cy="22" r="2" fill={hole} />
    <circle cx="27" cy="7.5" r="2.2" fill="#c9f24b" />
  </svg>
  <span style={`font-size:${size * 0.72}px;line-height:1;font-weight:600;letter-spacing:-0.03em`}>BestBrookies</span>
</span>
