---
interface Props { dark?: boolean; size?: number }
const { dark = false, size = 46 } = Astro.props;
const fg = dark ? '#f3eee4' : '#15171a';
---
<span class="inline-flex items-center gap-[14px]" style={`color:${fg}`}>
  <svg viewBox="0 0 32 32" width={size} height={size}><rect width="32" height="32" rx="7" fill={dark ? '#f3eee4' : '#15171a'} /><path d="M5 21.5c3.2 0 4.2-4 7.4-4s3.6 2.6 6.4 2.6c2.4 0 3.4-3.3 5-6.4L27 9" fill="none" stroke={dark ? '#d9442b' : '#f5b700'} stroke-width="3" stroke-linecap="round" stroke-linejoin="round" /><path d="M22.4 8.4 27 9l-.5 4.6" fill="none" stroke={dark ? '#d9442b' : '#f5b700'} stroke-width="3" stroke-linecap="round" stroke-linejoin="round" /></svg>
  <span style={`font-size:${size * 0.82}px;line-height:1`}><b>Best</b><i style="font-family:var(--font-display);font-weight:500">Brookies</i></span>
</span>
