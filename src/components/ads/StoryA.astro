---
import TwinCards from './TwinCards.astro';
import Brand from './Brand.astro';
---
<div data-ad="ad-a-story" class="ad relative h-[1920px] w-[1080px] overflow-hidden bg-white px-[90px] pt-[250px] text-[#0a0a0a]">
  <div class="ad-grid absolute inset-0"></div>
  <div class="relative"><Brand size={54} /></div>
  <h1 class="relative mt-[60px] text-[120px] leading-[0.96] font-semibold tracking-[-0.05em]">Chcete VOO?<br />V Česku ho nekoupíte.</h1>
  <p class="relative mt-[30px] text-[64px] font-semibold tracking-[-0.03em]">Tady je jeho <span class="hl">dvojče.</span></p>
  <div class="relative mt-[60px]"><TwinCards scale={1} /></div>
  <div class="absolute right-[90px] bottom-[330px] left-[90px] text-center">
    <span class="inline-block rounded-full bg-[#0a0a0a] px-[60px] py-[34px] text-[42px] font-semibold text-white">12 dvojčat v balíčku zdarma ↑</span>
  </div>
</div>
