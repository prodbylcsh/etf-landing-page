---
import Brand from './Brand.astro';
import CookieChart from '../islands/CookieChart';
import { cheapTwinTer, czechFund } from '../../lib/market';
import { feeComparison } from '../../lib/finance';
import { fmtInt, pct, ter } from '../../lib/format';
const r = feeComparison(3000, 25, 0.07, cheapTwinTer, czechFund.value);
---
<div data-ad="ad-b-story" class="ad relative h-[1920px] w-[1080px] overflow-hidden bg-[#0b0c0e] px-[90px] pt-[250px] text-white">
  <div class="absolute -top-[200px] -right-[200px] h-[900px] w-[900px] rounded-full bg-[#c9f24b] opacity-[0.16] blur-[160px]"></div>
  <div class="relative"><Brand dark size={54} /></div>
  <h1 class="relative mt-[60px] text-[120px] leading-[0.96] font-semibold tracking-[-0.05em]">Kolik vám ukousnou <span class="text-[#c9f24b]">poplatky?</span></h1>
  <div class="relative mt-[50px] flex justify-center"><CookieChart share={r.lost / r.cheap} size={380} dark /></div>
  <p class="num relative mt-[40px] text-center text-[130px] leading-none font-semibold tracking-[-0.05em] text-[#ff6b6b]">−{fmtInt(Math.round(r.lost / 1000))} tis. Kč</p>
  <p class="relative mt-[20px] text-center text-[36px] leading-snug text-[#a1a1aa]">za 25 let při 3 000 Kč měsíčně<br />fond {pct(czechFund.value, 2)} vs. ETF {ter(cheapTwinTer)}</p>
  <div class="absolute right-[90px] bottom-[270px] left-[90px] text-center">
    <span class="inline-block rounded-full bg-[#c9f24b] px-[60px] py-[34px] text-[42px] font-semibold text-[#0a0a0a]">Spočítejte si to sami ↑</span>
  </div>
</div>
