---
import Brand from './Brand.astro';
import CookieChart from '../islands/CookieChart';
import { cheapTwinTer, czechFund } from '../../lib/market';
import { feeComparison } from '../../lib/finance';
import { fmtInt, pct, ter } from '../../lib/format';
const r = feeComparison(3000, 25, 0.07, cheapTwinTer, czechFund.value);
---
<div data-ad="ad-b-feed" class="ad relative h-[1350px] w-[1080px] overflow-hidden bg-[#0b0c0e] px-[90px] pt-[80px] text-white">
  <div class="absolute -top-[300px] -right-[200px] h-[800px] w-[800px] rounded-full bg-[#c9f24b] opacity-[0.16] blur-[140px]"></div>
  <div class="relative"><Brand dark /></div>
  <h1 class="relative mt-[70px] text-[112px] leading-[0.98] font-semibold tracking-[-0.05em]">Kolik vám ukousnou <span class="text-[#c9f24b]">poplatky?</span></h1>
  <div class="relative mt-[60px] flex items-center gap-[60px]">
    <CookieChart share={r.lost / r.cheap} size={330} dark />
    <div>
      <p class="num text-[124px] leading-none font-semibold tracking-[-0.05em] text-[#ff6b6b]">−{fmtInt(Math.round(r.lost / 1000))} tis.</p>
      <p class="mt-[20px] text-[32px] leading-snug text-[#a1a1aa]">za 25 let při 3 000 Kč měsíčně.<br />Fond {pct(czechFund.value, 2)} vs. ETF {ter(cheapTwinTer)}</p>
    </div>
  </div>
  <div class="absolute right-[90px] bottom-[80px] left-[90px] flex items-end justify-between gap-[30px]">
    <p class="text-[22px] leading-snug text-[#71717a]">Předpoklad 7 % ročně před poplatky.<br />Ilustrativní výpočet, ne doporučení.</p>
    <span class="shrink-0 rounded-full bg-[#c9f24b] px-[48px] py-[30px] text-[36px] font-semibold text-[#0a0a0a]">Spočítat zdarma →</span>
  </div>
</div>
