---
// Náhled PDF taháku (3 „stránky“ z CSS). Hodnota je vidět ještě před formulářem.
import { etfs } from '../lib/market';
interface Props { size?: 'sm' | 'lg'; class?: string }
const { size = 'lg', class: cls = '' } = Astro.props;
const rows = etfs.slice(0, 7);
const sm = size === 'sm';
---
<div class:list={['relative select-none', sm ? 'h-[92px] w-[78px]' : 'h-[300px] w-[250px] md:h-[360px] md:w-[300px]', cls]} aria-hidden="true">
  <!-- strana 3: daně -->
  <div class="absolute inset-0 origin-bottom-left translate-x-[14%] rotate-[7deg] rounded-[4px] bg-white shadow-md ring-1 ring-black/5">
    {!sm && (
      <div class="p-4">
        <p class="font-mono text-[8px] tracking-widest text-[var(--color-muted)]">03 · DANĚ V ČR</p>
        <p class="mt-1 font-[family-name:var(--font-display)] text-[15px] font-semibold leading-tight">Časový test, 100 000 Kč a DIP</p>
        <div class="mt-3 space-y-1.5">
          {[90, 70, 82, 55, 76].map((w) => <div class="h-1.5 rounded bg-[var(--color-rule)]" style={`width:${w}%`} />)}
        </div>
      </div>
    )}
  </div>
  <!-- strana 2: překladač -->
  <div class="absolute inset-0 origin-bottom-left translate-x-[6%] rotate-[3deg] rounded-[4px] bg-white shadow-md ring-1 ring-black/5">
    {!sm && (
      <div class="p-4">
        <p class="font-mono text-[8px] tracking-widest text-[var(--color-muted)]">01 · PŘEKLADAČ NYSE → ČESKO</p>
        <div class="mt-2 divide-y divide-[var(--color-rule)]">
          {rows.map((e) => (
            <div class="flex items-center justify-between py-[3px] font-mono text-[9px]">
              <span class="font-bold">{e.ticker}</span>
              <span class="text-[var(--color-muted)]">→</span>
              <span class="w-[58%] truncate text-right" style={e.twin.free ? '' : 'filter:blur(2.5px)'}>{e.twin.free ? e.twin.isin : 'IE00XXXXXXXX'}</span>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
  <!-- strana 1: obálka -->
  <div class="absolute inset-0 flex flex-col overflow-hidden rounded-[4px] bg-[var(--color-term)] shadow-xl ring-1 ring-black/10">
    {sm ? (
      <div class="flex h-full flex-col justify-between p-2">
        <span class="font-mono text-[6px] font-bold tracking-widest text-[var(--color-phosphor)]">PDF</span>
        <span class="font-[family-name:var(--font-display)] text-[11px] leading-[1.05] font-semibold text-white">ETF tahák 2026</span>
      </div>
    ) : (
      <div class="flex h-full flex-col p-5">
        <div class="flex items-center justify-between">
          <span class="font-mono text-[9px] font-bold tracking-widest text-[var(--color-phosphor)]">BESTBROOKIES</span>
          <span class="font-mono text-[9px] text-[#7f948a]">PDF · 6 STRAN</span>
        </div>
        <p class="mt-auto font-[family-name:var(--font-display)] text-[2.1rem] leading-[0.98] font-semibold text-white md:text-[2.5rem]">ETF<br />tahák<br /><span class="text-[var(--color-amber)] italic">2026</span></p>
        <p class="mt-3 text-[11.5px] leading-snug text-[#b9c7c0]">12 slavných ETF z NYSE a jejich evropská dvojčata, která si koupíte v Česku.</p>
        <svg viewBox="0 0 200 40" class="mt-4 w-full" fill="none"><path d="M0 32c25 0 32-14 56-14s28 9 50 9c19 0 27-12 40-22L200 2" stroke="#f5b700" stroke-width="3" stroke-linecap="round" /></svg>
      </div>
    )}
  </div>
</div>
